#!/usr/bin/env python3
"""Guide a fresh Artix/runit restore using the existing stage scripts."""
import argparse
import grp
import os
from pathlib import Path
import pwd
import shlex
import shutil
import subprocess
import sys

REPO = Path(__file__).resolve().parent
STAGES = ('repositories', 'packages', 'aur', 'desktop', 'configuration', 'services', 'boot', 'verify')

class Paused(Exception):
    pass

class Installer:
    def __init__(self, profile, dry_run=False, start='repositories'):
        self.profile, self.dry_run, self.stage = profile, dry_run, start

    def resume(self):
        return f'./install --profile {self.profile} --from {self.stage}'

    def command(self, *args, allowed=(0,)):
        print('+ ' + shlex.join(map(str, args)), flush=True)
        if self.dry_run:
            return 0
        result = subprocess.run(args, cwd=REPO)
        if result.returncode not in allowed:
            raise subprocess.CalledProcessError(result.returncode, args)
        return result.returncode

    def script(self, name, *args, root=False, **kwargs):
        command = ['doas'] if root else []
        return self.command(*command, str(REPO / 'scripts' / name), *args, **kwargs)

    def gate(self, message, word='continue'):
        print('\nREVIEW / MANUAL STEP: ' + message, flush=True)
        if not self.dry_run and input(f'Type {word} when ready, or Enter to stop: ').strip() != word:
            raise Paused('Stopped at the manual review above.')

    def preflight(self):
        if not sys.stdin.isatty():
            raise ValueError('Use an interactive terminal, or --dry-run to inspect the plan.')
        account = pwd.getpwuid(os.getuid())
        if (os.geteuid() != 1000 or os.getgid() != 1000 or account.pw_gid != 1000 or account.pw_name != 'bren' or
                account.pw_dir != '/home/bren' or account.pw_shell != '/bin/bash' or
                Path.home() != Path('/home/bren')):
            raise ValueError('Run as bren (UID 1000, /home/bren, Bash), without doas. See docs/install.md.')
        if 'ID=artix' not in Path('/etc/os-release').read_text().replace('"', '').splitlines():
            raise ValueError('This installer requires Artix. See docs/install.md for prerequisites.')
        if Path('/sbin/init').resolve().name != 'runit-init':
            raise ValueError('Expected an Artix/runit base installation.')
        for name in ('doas', 'pacman', 'git', 'python3', 'findmnt'):
            if not shutil.which(name):
                raise ValueError(f'Missing prerequisite {name}; see docs/install.md.')
        if self.stage == 'verify':
            return
        if any(os.environ.get(name) for name in ('WAYLAND_DISPLAY', 'DISPLAY', 'SSH_CONNECTION')):
            raise ValueError('Install from a local text console such as tty2. Use --from verify after graphical login.')
        if self.profile == 'framework':
            mount = subprocess.check_output(['findmnt', '-n', '-o', 'FSTYPE,OPTIONS',
                                             '--mountpoint', '/boot'], text=True).split()
            if len(mount) != 2 or mount[0] != 'vfat' or 'rw' not in mount[1].split(','):
                raise ValueError('Mount the Framework FAT ESP read-write at /boot before package upgrades; see docs/boot.md.')

    def repositories(self):
        # This was the manual Pacman setup in docs/install.md. Keep the same
        # ordinary commands and explicit policy review; never replace mirrors.
        self.command('doas', 'pacman', '-Syu', '--needed', 'artix-archlinux-support')
        target, backup = Path('/etc/pacman.conf'), Path('/etc/pacman.conf.before-bootstrap')
        if not self.dry_run:
            if (target.is_symlink() or not target.is_file() or backup.is_symlink()
                    or (backup.exists() and not backup.is_file())):
                raise ValueError('Resolve the Pacman configuration/backup paths manually; regular files are required.')
            if target.read_bytes() == (REPO / 'templates/pacman.conf').read_bytes():
                print('Pacman policy already matches. Keeping the existing backup and mirrors.')
                return
        self.command('diff', '-u', str(target), str(REPO / 'templates/pacman.conf'), allowed=(0, 1))
        self.gate('Review the Pacman diff and both distribution mirrorlists (docs/install.md, step 2). '
                  'Replace pacman.conf with this template and retain its first backup?', word='replace')
        self.command('doas', '/usr/bin/cp', '-an', str(target), str(backup))
        self.command('doas', '/usr/bin/install', '-m644', str(REPO / 'templates/pacman.conf'), str(target))
        self.command('pacman-conf', '--repo-list')

    def packages(self):
        self.script('packages', '--profile', self.profile)
        self.script('packages', '--profile', self.profile, '--apply', root=True)

    def aur(self):
        self.script('yay')
        if self.script('yay', '--apply', allowed=(0, 3)) == 3:
            raise Paused('Stopped before building the AUR helper. Review docs/packages.md and resume when ready.')
        self.script('aur')
        self.script('aur', '--apply')

    def desktop(self):
        self.script('sources')
        self.script('desktop')
        self.script('check')

    def configuration(self):
        for scope in ('home', 'system'):
            self.script('files', '--profile', self.profile, '--scope', scope, root=scope == 'system')
        self.gate('Review both file previews above. Type replace to authorize the existing files stage\'s '
                  'backed-up replacements, including PAM/login policy. Keep tty2 available for recovery.', word='replace')
        for scope in ('home', 'system'):
            self.script('files', '--profile', self.profile, '--scope', scope,
                        '--replace', '--apply', root=scope == 'system')
        self.script('permissions')
        self.script('permissions', '--apply', root=True)
        self.command('doas', 'doas', '-C', '/etc/doas.conf')

    def services(self):
        if not self.dry_run:
            active = set(os.getgroups()) | {os.getgid()}
            required = (REPO / 'manifests/groups.txt').read_text().splitlines()
            if any(grp.getgrnam(name).gr_gid not in active for name in required if name and not name.startswith('#')):
                raise Paused('Log out and back into tty2 to activate the restored groups, then resume here.')
        wifi = ('Supply root-owned mode-0600 home.conf, hotspot.conf and school.conf in /etc/wpa_supplicant. '
                if self.profile == 'framework' else '')
        self.gate(wifi + 'Restore personal images/VM/private inputs from docs/secrets.md in another console. '
                  'Check temporary installation networking will not compete with the restored services. '
                  'Enter no secrets into this prompt.')
        self.script('services', '--profile', self.profile)
        self.gate('Enable the listed services? New links can start networking, SSH and tty1 autologin immediately. '
                  'Existing processes are left running with their current configuration.')
        self.script('services', '--profile', self.profile, '--apply', root=True)

    def boot(self):
        if self.profile == 'framework':
            self.gate('Complete docs/boot.md through "Render and apply machine values": review the actual disk, '
                      'UUIDs, Btrfs mounts and swap; render/review/install fstab using the documented commands. '
                      'The next action builds the matching kernel/initramfs with backups. No partitioning is performed.')
            self.script('initramfs')
            self.script('initramfs', '--apply', root=True)
            self.gate('Follow docs/boot.md "EFI registration": inspect and reuse or deliberately create the correct '
                      'entry, select BootNext if needed, and retain a recovery boot path. EFI decisions are manual. '
                      'Continue for the pre-reboot verification; physical boot testing comes afterward.')
        else:
            self.gate('Review your hardware-specific boot/kernel/initramfs and EFI setup before rebooting. '
                      'The portable profile does not install the Framework initramfs policy.')

    def verify(self):
        status = self.script('verify', '--profile', self.profile, root=True, allowed=(0, 1, 2))
        print('\nManual completion: follow docs/verify.md for fresh boot, tty2 login, lock/unlock, '
              'networking, audio, screen sharing and physical suspend/hibernate tests. '
              'Enroll fingerprints, pair devices and authenticate applications locally (docs/secrets.md).')
        print('After booting into the restored desktop, rerun: ' + self.resume())
        if status:
            print('Verification is incomplete or found differences. Pre-reboot session/kernel findings may be expected; '
                  'review each finding. Installation is not declared verified.')
        elif not self.dry_run:
            print('Automated verification passed. Physical acceptance tests remain manual.')
        return status

    def run(self):
        if not self.dry_run:
            self.preflight()
        print(f'Artix bootstrap ({self.profile}); stages: ' + ' -> '.join(STAGES[STAGES.index(self.stage):]))
        if self.stage != 'verify':
            self.gate('This restores the selected profile on the target installation. Pacman/AUR transactions retain '
                      'their prompts. Use a fresh Artix/runit base and read docs/install.md; package hooks can update /boot.',
                      word='install')
        start = STAGES.index(self.stage)
        for stage in STAGES[start:]:
            self.stage = stage
            print('\nStage: ' + stage, flush=True)
            status = getattr(self, stage)()
            if status:
                return status
        return 0

def main(argv=None):
    parser = argparse.ArgumentParser(description=__doc__)
    parser.add_argument('--profile', choices=('portable', 'framework'), default='portable')
    parser.add_argument('--dry-run', action='store_true', help='print all commands and manual gates without executing anything')
    parser.add_argument('--from', dest='start', choices=STAGES, default='repositories', help='resume explicitly at a named stage')
    args = parser.parse_args(argv)
    installer = Installer(args.profile, args.dry_run, args.start)
    try:
        return installer.run()
    except (Paused, EOFError) as error:
        print(f'\nPaused: {error}\nResume: {installer.resume()}', file=sys.stderr)
        return 3
    except KeyboardInterrupt:
        print(f'\nInterrupted. Inspect the last command before resuming: {installer.resume()}', file=sys.stderr)
        return 130
    except (OSError, ValueError, KeyError, subprocess.CalledProcessError) as error:
        print(f'\nStopped in {installer.stage}: {error}\nResolve the error, then resume: {installer.resume()}', file=sys.stderr)
        return 1

if __name__ == '__main__':
    sys.exit(main())
