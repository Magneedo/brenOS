# Copy/edit locally only. This is a template, not a usable network profile.
ctrl_interface=/run/wpa_supplicant
update_config=1
country=US

network={
    ssid="SUPPLY_LOCALLY"
    # Add the generated psk locally. Never commit it, including its hash form.
    key_mgmt=WPA-PSK
    # The reference hotspot.conf also uses scan_ssid=1; home.conf does not.
}
