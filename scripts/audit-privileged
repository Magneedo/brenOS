#!/usr/bin/env python3
"""Read-only allowlisted audit. Exclude Wi-Fi secret values; never open keys/shadow."""
import hashlib
import json
import os
from pathlib import Path
import subprocess
import sys
from common import lines

if os.geteuid() != 0:
    sys.exit('Run with doas from a terminal; this script only reads state.')

def command(*args):
    result = subprocess.run(args, text=True, capture_output=True, timeout=30,
                            env=dict(os.environ, LC_ALL='C'))
    return {'status': result.returncode, 'stdout': result.stdout, 'stderr': result.stderr}

report = {}
report['protected_md5'] = {}
for name in ('/etc/crypttab', '/etc/default/useradd', '/etc/libaudit.conf', '/etc/ssh/sshd_config'):
    path = Path(name)
    if path.is_file():
        report['protected_md5'][name] = hashlib.md5(path.read_bytes()).hexdigest()
for name in ('/etc/doas.conf', '/etc/pam.d/doas', '/etc/pam.d/swaylock',
             '/etc/pam.d/system-local-login', '/etc/security/limits.conf',
             '/etc/nsswitch.conf', '/etc/shells', '/etc/subuid', '/etc/subgid'):
    p = Path(name)
    report[name] = p.read_text() if p.is_file() else None
for name in ('/etc/crypttab', '/etc/default/useradd', '/etc/libaudit.conf'):
    # Compare protected package backups without exposing their contents.
    p = Path(name)
    if p.is_file():
        report[name] = {'md5': hashlib.md5(p.read_bytes()).hexdigest()}
for key, args in {
    'groups': ('id', 'bren'),
    'mounts': ('findmnt', '--real', '-o', 'TARGET,SOURCE,FSTYPE,OPTIONS'),
    'subvolumes': ('btrfs', 'subvolume', 'list', '/'),
    'swap': ('swapon', '--show'),
    'capabilities': ('getcap', '-r', '/usr/bin', '/usr/local', '/opt'),
    'user_cron': ('crontab', '-u', 'bren', '-l'),
    'root_cron': ('crontab', '-l'),
}.items():
    try:
        report[key] = command(*args)
    except FileNotFoundError:
        report[key] = {'unavailable': args[0]}
for directory in ('/etc/polkit-1/rules.d', '/var/spool/cron', '/etc/cron.d',
                  '/etc/ssh/sshd_config.d', '/etc/wpa_supplicant'):
    p = Path(directory)
    entries = []
    for f in sorted(p.iterdir()) if p.is_dir() else []:
        st = f.lstat()
        entry = {'name': f.name, 'mode': oct(st.st_mode & 0o7777),
                 'uid': st.st_uid, 'gid': st.st_gid}
        if directory in ('/etc/polkit-1/rules.d', '/etc/ssh/sshd_config.d'):
            owner = command('pacman', '-Qqo', str(f))
            entry['package'] = owner['stdout'].strip() if owner['status'] == 0 else None
        entries.append(entry)
    report[directory] = entries
# Pacman's own mtree checks cover packaged files and symlink targets without
# teaching this bootstrap a second package-file integrity format.
report['policy_package_checks'] = {
    name: command('pacman', '-Qkk', name) for name in lines('policy-packages.txt')
}
# Authentication methods and control socket policy, excluding SSIDs, identities,
# passwords, key material and certificate contents.
report['wifi_methods'] = {}
report['wifi_fields'] = {}
allowed_wifi = {'ctrl_interface', 'update_config', 'country', 'ap_scan',
                'key_mgmt', 'eap', 'phase1', 'phase2', 'proto', 'pairwise',
                'group', 'ieee80211w', 'scan_ssid'}
private_wifi = {'ssid', 'psk', 'sae_password', 'identity', 'anonymous_identity',
                'password', 'ca_cert', 'ca_path', 'client_cert', 'private_key',
                'private_key_passwd', 'domain_match', 'domain_suffix_match',
                'subject_match', 'altsubject_match'}
for profile in Path('/etc/wpa_supplicant').glob('*.conf'):
    settings = [line.split('#', 1)[0].strip() for line in profile.read_text().splitlines()]
    report['wifi_methods'][profile.name] = [
        line for line in settings if line.partition('=')[0].strip() in allowed_wifi
    ]
    # Names only identify locally supplied fields such as ca_cert/domain_match;
    # their values (including identity, password and certificate paths) stay out.
    report['wifi_fields'][profile.name] = sorted({
        line.partition('=')[0].strip() for line in settings
        if line.partition('=')[0].strip() in allowed_wifi | private_wifi
    })
ssh = Path('/etc/ssh/sshd_config')
if ssh.is_file():
    # Configuration only; never open host keys, authorized_keys or certificates.
    report[str(ssh)] = '\n'.join(l for l in ssh.read_text().splitlines()
                                if l.strip() and not l.lstrip().startswith('#'))
print(json.dumps(report, indent=2))
