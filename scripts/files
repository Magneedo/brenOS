#!/usr/bin/env python3
"""Preview or copy allowlisted configuration, with backups and conflict checks."""
import argparse
import datetime
import os
from pathlib import Path
import shutil
import sys
import tempfile
from common import equivalent, file_rows, source_path, target_path

def main():
    p = argparse.ArgumentParser(description=__doc__)
    p.add_argument('--profile', choices=['portable', 'framework'], default='portable')
    p.add_argument('--scope', choices=['home', 'system', 'all'], required=True)
    p.add_argument('--root', type=Path, default=Path('/'), help='staging filesystem root for a rehearsal')
    p.add_argument('--apply', action='store_true')
    p.add_argument('--replace', action='store_true', help='back up and replace differing regular files')
    a = p.parse_args()
    root = a.root.resolve()
    if root == Path('/') and a.apply:
        if a.scope == 'all':
            p.error('On the live filesystem, run home and system scopes separately')
        if a.scope == 'system' and os.geteuid() != 0:
            p.error('Use doas for system files')
        if a.scope == 'home' and (os.geteuid() == 0 or Path.home() != Path('/home/bren')):
            p.error('Install home files as bren in /home/bren')
    plan, conflicts = [], []
    for _, origin, relative, destination, mode in file_rows(a.profile):
        home_file = destination.startswith('home/')
        if (a.scope == 'home' and not home_file) or (a.scope == 'system' and home_file):
            continue
        source = source_path(origin, relative)
        target = target_path(root, destination)
        if target.exists() and not target.is_file():
            raise ValueError(f'Not a regular file: {target}')
        equal = equivalent(source, target, destination)
        correct_mode = target.exists() and (target.stat().st_mode & 0o7777) == int(mode, 8)
        correct_owner = target.exists() and (root != Path('/') or target.stat().st_uid == os.geteuid())
        if equal and correct_mode and correct_owner:
            continue
        action = 'ADD' if not target.exists() else 'MODE/OWNER' if equal else 'REPLACE'
        print(f'{action} {target} ({mode})')
        if action == 'REPLACE' and not a.replace:
            conflicts.append(str(target))
        plan.append((source, target, destination, mode, equal))
    if not a.apply:
        print(f'Preview: {len(plan)} changes. --apply writes; --replace authorizes backed-up replacements.')
        return 0
    if conflicts:
        raise ValueError('No files changed. Existing files differ; review and rerun with --replace:\n' + '\n'.join(conflicts))
    stamp = datetime.datetime.now(datetime.timezone.utc).strftime('%Y%m%dT%H%M%S.%fZ')
    backup_base = ('home/bren/.local/state/artix-bootstrap/backups' if a.scope == 'home'
                   else 'var/lib/artix-bootstrap/backups')
    backup = target_path(root, backup_base + '/' + stamp)
    for source, target, destination, mode, equal in plan:
        if target.exists():
            saved = backup / destination
            saved.parent.mkdir(parents=True, exist_ok=True)
            backup.chmod(0o700)
            shutil.copy2(target, saved)
        target.parent.mkdir(parents=True, exist_ok=True)
        if not equal:
            fd, temp = tempfile.mkstemp(prefix='.bootstrap-', dir=target.parent)
            try:
                with os.fdopen(fd, 'wb') as stream:
                    stream.write(source.read_bytes())
                os.chmod(temp, int(mode, 8))
                os.replace(temp, target)
            finally:
                if os.path.exists(temp):
                    os.unlink(temp)
        os.chmod(target, int(mode, 8))
        if root == Path('/'):
            os.chown(target, os.geteuid(), os.getegid())
    print(f'Applied {len(plan)} changes.' + (f' Backups: {backup}' if backup.exists() else ''))
    return 0

if __name__ == '__main__':
    try:
        sys.exit(main())
    except (OSError, ValueError) as e:
        sys.exit(f'files: {e}')
