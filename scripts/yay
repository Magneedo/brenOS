#!/usr/bin/env python3
"""Bootstrap the reviewed AUR helper as an ordinary user; preview by default."""
import argparse
import os
from pathlib import Path
import shutil
import subprocess
import sys
from common import REPO, run, output, target_path

URL = 'https://aur.archlinux.org/yay.git'
REVISION = 'cb43f84828ab4f9700f7c6f9c6d7a923d4cfaff0'

def main(argv=None):
    parser = argparse.ArgumentParser(description=__doc__)
    parser.add_argument('--apply', action='store_true')
    args = parser.parse_args(argv)
    print(f'Plan: keep an installed yay; otherwise prepare {URL} at {REVISION},')
    print('review its recipe, then run makepkg -si --needed as your user with doas authentication.')
    if not args.apply:
        return 0
    if os.geteuid() == 0:
        raise ValueError('Build yay as bren, never as root.')
    if shutil.which('yay'):
        print('yay is already available; scripts/aur handles its normal package updates.')
        return 0
    if not sys.stdin.isatty():
        raise ValueError('A terminal is required for recipe review and package prompts.')
    source = target_path(REPO, '.work/aur/yay')
    source.parent.mkdir(parents=True, exist_ok=True)
    if not source.exists():
        run('git', 'clone', '--', URL, str(source))
    if output('git', '-C', str(source), 'remote', 'get-url', 'origin') != URL:
        raise ValueError(f'Unexpected Git origin in {source}')
    # Preserve edits to an existing recipe; build artifacts need not be removed.
    run('git', '-C', str(source), 'diff', '--exit-code')
    run('git', '-C', str(source), 'diff', '--cached', '--exit-code')
    if subprocess.run(['git', '-C', str(source), 'cat-file', '-e', REVISION + '^{commit}'],
                      stdout=subprocess.DEVNULL, stderr=subprocess.DEVNULL).returncode:
        run('git', '-C', str(source), 'fetch', 'origin', REVISION)
    run('git', '-C', str(source), 'checkout', '--detach', REVISION)
    # Display every tracked recipe input, including any install script, before
    # executing makepkg. No automatic key imports or skipped signature checks.
    for relative in output('git', '-C', str(source), 'ls-files').splitlines():
        path = target_path(source, relative)
        print(f'\n--- {path} ---\n{path.read_text()}', flush=True)
    if input('Review complete? Type build to build/install yay, or Enter to stop: ').strip() != 'build':
        print('Stopped before makepkg. Resume with scripts/yay --apply.')
        return 3
    config = REPO / '.work/makepkg.conf'
    config.write_text('source /etc/makepkg.conf\nPACMAN_AUTH=(doas)\n')
    subprocess.run(['makepkg', '--config', str(config), '-si', '--needed'], cwd=source, check=True)
    if not shutil.which('yay'):
        raise ValueError('makepkg returned without installing yay; inspect its package prompts.')
    return 0

if __name__ == '__main__':
    try:
        sys.exit(main())
    except (OSError, ValueError, subprocess.CalledProcessError) as error:
        sys.exit(f'yay: {error}\nSee docs/packages.md; resolve the failure and rerun.')
    except (EOFError, KeyboardInterrupt):
        sys.exit('Stopped. Resume with scripts/yay --apply when ready.')
