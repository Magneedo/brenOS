#!/usr/bin/env python3
"""Restore native packages using a normal, interactive, full Pacman transaction."""
import argparse
import os
import shlex
import sys
from common import lines, selected, run

p = argparse.ArgumentParser(description=__doc__)
p.add_argument('--profile', choices=['portable', 'framework'], default='portable')
p.add_argument('--apply', action='store_true')
a = p.parse_args()
packages = sorted(set(selected('packages', a.profile) + lines('packages-runtime.txt')))
command = ['pacman', '-Syu', '--needed', '--', *packages]
print(shlex.join(command), flush=True)
if a.apply:
    if os.geteuid() != 0:
        sys.exit('Use doas for --apply. Configure repositories first; see docs/install.md.')
    run(*command)
    # --needed may leave an already installed package marked as a dependency.
    run('pacman', '-D', '--asexplicit', '--', *packages)
