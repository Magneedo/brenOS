#!/usr/bin/env python3
"""Check tracked inputs, source coverage, syntax and obvious secret mistakes."""
import ast
from pathlib import Path
import re
import subprocess
import sys
from common import REPO, file_rows, lines, source_path, selected

tracked = set(subprocess.check_output(['git', '-C', str(REPO), 'ls-files'], text=True).splitlines())
errors = []
destinations = set()
for _, origin, relative, destination, mode in file_rows('framework'):
    if destination in destinations:
        errors.append('Duplicate destination ' + destination)
    destinations.add(destination)
    if origin == 'bootstrap' and relative not in tracked:
        errors.append('Source is not tracked (possibly ignored): ' + relative)
    try:
        source_path(origin, relative)
    except ValueError as e:
        errors.append(str(e))
    if not re.fullmatch(r'0[0-7]{3}', mode):
        errors.append('Invalid file mode: ' + mode)
snapshot = set((REPO/'docs/packages-explicit.txt').read_text().splitlines())
manifest = set(selected('packages', 'framework') + lines('packages-aur.txt') + lines('packages-local.txt'))
if snapshot != manifest:
    errors.append('Explicit package snapshot and restoration manifests differ: ' + ', '.join(sorted(snapshot ^ manifest)))
if not set(lines('policy-packages.txt')) <= manifest | set(lines('packages-runtime.txt')):
    errors.append('Protected policy packages must be included in package restoration')
for row in lines('directories.tsv'):
    directory, owner, group, mode = row.split('\t')
    if not Path(directory).is_absolute() or '..' in Path(directory).parts or not re.fullmatch(r'0[0-7]{3}', mode):
        errors.append('Invalid directory permission: ' + row)
patterns = [re.compile(p) for p in (
    r'-----BEGIN (?:RSA |EC |OPENSSH |DSA )?PRIVATE KEY-----',
    r'gh[pousr]_[A-Za-z0-9]{30,}', r'github_pat_[A-Za-z0-9_]{40,}',
    r'AKIA[0-9A-Z]{16}', r'sk-proj-[A-Za-z0-9_-]{30,}',
)]
for relative in sorted(tracked):
    path = REPO/relative
    if path.suffix.lower() in {'.pem', '.key', '.crt', '.p12', '.pfx', '.qcow2', '.vmdk', '.sqlite', '.db'}:
        errors.append('Disallowed state/credential file: ' + relative)
    if relative.startswith(('.work/', 'local/')) or any(s in path.parts for s in ('.ssh', '.gnupg', 'node_modules')):
        errors.append('Disallowed directory: ' + relative)
    data = path.read_bytes()
    if b'\0' in data or len(data) > 1024*1024:
        errors.append('Unexpected binary or large file: ' + relative)
        continue
    text = data.decode()
    if any(p.search(text) for p in patterns):
        errors.append('Possible credential: ' + relative)
    if relative.startswith('scripts/') or relative == 'tests/rehearsal.py':
        if relative.endswith('.py') or text.startswith('#!/usr/bin/env python3'):
            try:
                ast.parse(text, filename=relative)
            except SyntaxError as e:
                errors.append(str(e))
        elif text.startswith('#!/usr/bin/env bash'):
            r = subprocess.run(['bash', '-n', str(path)], capture_output=True, text=True)
            if r.returncode:
                errors.append(r.stderr)
    if path.name in ('PKGBUILD', 'mullvad-vpn.install'):
        r = subprocess.run(['bash', '-n', str(path)], capture_output=True, text=True)
        if r.returncode:
            errors.append(r.stderr)
if errors:
    sys.exit('\n'.join(errors))
print(f'Checked {len(tracked)} tracked text files, {len(destinations)} destinations and all {len(snapshot)} explicit packages.')
print('Obvious-secret scan passed. Human allowlist/content review is still required before committing new captures.')
