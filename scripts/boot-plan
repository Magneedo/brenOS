#!/usr/bin/env python3
"""Render Framework fstab and EFISTUB arguments; never touch disks or firmware."""
import argparse
from pathlib import Path
import re

p = argparse.ArgumentParser(description=__doc__)
p.add_argument('--root-uuid', required=True)
p.add_argument('--esp-uuid', required=True)
p.add_argument('--swap-uuid', required=True)
p.add_argument('--output', type=Path, default=Path('local/boot'))
a = p.parse_args()
uuid = r'[0-9a-fA-F]{8}(?:-[0-9a-fA-F]{4}){3}-[0-9a-fA-F]{12}'
if not all(re.fullmatch(uuid, v) for v in (a.root_uuid, a.swap_uuid)):
    p.error('root/swap UUIDs must be filesystem UUIDs in 8-4-4-4-12 form')
if not re.fullmatch(r'[0-9a-fA-F]{4}-[0-9a-fA-F]{4}', a.esp_uuid):
    p.error('ESP UUID must be the FAT filesystem UUID, in XXXX-XXXX form')
if a.root_uuid.lower() == a.swap_uuid.lower():
    p.error('Root and swap must be different filesystems')
options = 'rw,noatime,compress=zstd:3,ssd,discard=async,space_cache=v2,commit=30'
fstab = (f'UUID={a.root_uuid} / btrfs {options},subvol=/@ 0 0\n'
         f'UUID={a.root_uuid} /.snapshots btrfs {options},subvol=/@snapshots 0 0\n'
         f'UUID={a.esp_uuid} /boot vfat rw,relatime,fmask=0022,dmask=0022,codepage=437,iocharset=ascii,shortname=mixed,utf8,errors=remount-ro 0 2\n'
         f'UUID={a.swap_uuid} none swap defaults,discard=once,pri=100 0 0\n')
cmdline = (r'initrd=\intel-ucode.img initrd=\booster-linux.img '
           f'root=UUID={a.root_uuid} rootflags=subvol=@ rootfstype=btrfs rw rootwait '
           f'init=/sbin/init resume=UUID={a.swap_uuid} quiet loglevel=4\n')
a.output.mkdir(parents=True, exist_ok=True)
for name, content in [('fstab', fstab), ('cmdline', cmdline)]:
    target = a.output / name
    if target.is_symlink():
        p.error(f'Refusing symlink output: {target}')
    target.write_text(content)
print(f'Rendered {a.output}/fstab and {a.output}/cmdline. Review docs/boot.md before applying.')
