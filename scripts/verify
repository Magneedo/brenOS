#!/usr/bin/env python3
"""Read-only comparison with the intended installation. 0=pass, 1=drift, 2=incomplete."""
import argparse
import grp
import json
import os
from pathlib import Path
import pwd
import re
import shutil
import subprocess
import sys
from common import REPO, equivalent, file_rows, lines, selected, source_path, target_path, policy_integrity_ok

p = argparse.ArgumentParser(description=__doc__)
p.add_argument('--profile', choices=['portable', 'framework'], default='portable')
p.add_argument('--root', type=Path, default=Path('/'), help='only compare files inside a rehearsal root')
p.add_argument('--json', action='store_true')
a = p.parse_args()
root = a.root.resolve()
results = []

def record(level, check, detail):
    results.append(dict(level=level, check=check, detail=detail))

def check(condition, name, detail):
    record('PASS' if condition else 'FAIL', name, detail)

def command(*args):
    try:
        r = subprocess.run(args, text=True, capture_output=True, timeout=20)
    except (OSError, subprocess.TimeoutExpired) as e:
        record('UNKNOWN', args[0], str(e))
        return None
    if r.returncode:
        record('UNKNOWN', args[0], 'Command could not complete; rerun with required privileges outside a sandbox.')
        return None
    return r.stdout.strip()

for _, origin, relative, destination, mode in file_rows(a.profile):
    try:
        source = source_path(origin, relative)
        target = target_path(root, destination)
        if origin == 'desktop' and '/bin/' in destination:
            # Debug paths/toolchain changes affect binary hashes; test existence
            # and dynamic linking here, and rebuild/test source with desktop.
            check(target.is_file() and os.access(target, os.X_OK), destination, 'Compositor/bar executable installed')
        elif destination == 'usr/local/share/man/man1/dwl.1' and target.is_file():
            record('PASS' if equivalent(source, target, destination) else 'REVIEW', destination,
                   'The reference has an older manpage; restore uses the documentation in the pinned source')
        else:
            check(equivalent(source, target, destination), destination, 'Matches managed configuration')
        if target.exists():
            check(target.stat().st_mode & 0o7777 == int(mode, 8), destination + ':mode', 'Expected ' + mode)
            if root == Path('/'):
                expected_uid = 1000 if destination.startswith('home/') else 0
                check(target.stat().st_uid == expected_uid, destination + ':owner', f'Expected UID {expected_uid}')
    except PermissionError:
        record('UNKNOWN', destination, 'Permission denied; use doas for protected file comparisons')
    except (OSError, ValueError) as e:
        record('FAIL', destination, str(e))

if root == Path('/'):
    installed = command('pacman', '-Qq')
    expected = set(selected('packages', a.profile) + lines('packages-runtime.txt')
                   + lines('packages-aur.txt'))
    if installed is not None:
        missing = sorted(expected - set(installed.splitlines()))
        check(not missing, 'packages', 'Missing: ' + ', '.join(missing) if missing else f'All {len(expected)} required packages installed')
    explicit = command('pacman', '-Qqe')
    if explicit is not None:
        extra = sorted(set(explicit.splitlines()) - expected)
        if extra:
            record('REVIEW', 'extra-explicit-packages', ', '.join(extra))
    repos = command('pacman-conf', '--repo-list')
    if repos is not None:
        check(repos.splitlines() == ['system', 'world', 'galaxy', 'lib32', 'extra', 'multilib'],
              'pacman-repositories', 'Reference Artix-first repository order')
    groups = command('id', '-nG', 'bren')
    if groups is not None:
        missing = sorted(set(lines('groups.txt')) - set(groups.split()))
        check(not missing, 'groups', 'Missing: ' + ', '.join(missing) if missing else 'All supplemental groups present')
    for name in ('subuid', 'subgid'):
        try:
            check('bren:100000:65536' in (Path('/etc') / name).read_text().splitlines(), name, 'Reference subordinate ID allocation')
        except PermissionError:
            record('UNKNOWN', name, 'Permission denied')
    check(Path('/usr/bin/sh').is_symlink() and os.readlink('/usr/bin/sh') == 'dash', 'shell', '/usr/bin/sh -> dash')
    check(Path('/etc/localtime').resolve() == Path('/usr/share/zoneinfo/America/New_York'), 'timezone', 'America/New_York')
    for row in lines('capabilities.tsv'):
        path, caps = row.split('\t')
        actual = command('getcap', path)
        if actual is not None:
            check(actual == f'{path} {caps}', path + ':capability', caps)
    for row in lines('directories.tsv'):
        directory, owner, group, mode = row.split('\t')
        try:
            path = target_path(Path('/'), directory.removeprefix('/'))
            st = path.stat()
            check(path.is_dir() and st.st_uid == pwd.getpwnam(owner).pw_uid
                  and st.st_gid == grp.getgrnam(group).gr_gid
                  and st.st_mode & 0o7777 == int(mode, 8), 'directory:' + directory,
                  'Expected ' + owner + ':' + group + ' ' + mode)
        except (OSError, KeyError, ValueError) as e:
            record('FAIL', 'directory:' + directory, str(e))
    for path in ('/usr/bin/doas',):
        f = Path(path)
        check(f.is_file() and f.stat().st_mode & 0o4000 and f.stat().st_uid == 0, path + ':setuid', 'Root-owned setuid executable')
    names = selected('services', a.profile)
    base = Path('/etc/runit/runsvdir/default')
    check(Path('/etc/runit/runsvdir/current').resolve() == base, 'runlevel', 'current -> default')
    for name in names:
        definition = Path('/etc/runit/sv') / name
        link = base / name
        check(link.is_symlink() and link.resolve() == definition and not (definition / 'down').exists(),
              'service:' + name, 'Enabled in default runlevel, no down file')
        # runsv changes process permissions; unprivileged inability is incomplete,
        # never proof that a service is stopped or running.
        state = command('sv', 'status', str(link))
        if state is not None:
            check(state.startswith('run:'), 'running:' + name, 'Service process is running')
    if base.is_dir():
        extra = sorted(f.name for f in base.iterdir() if f.name not in names)
        if extra:
            record('REVIEW', 'extra-services', ', '.join(extra))
    modules = command('pkg-config', '--modversion', 'wlroots-0.19', 'fcft', 'wayland-server')
    if modules is not None:
        record('PASS', 'desktop-build-libraries', 'Required ABI/build metadata available')
    for binary in ('dwl', 'dwlb'):
        path = '/usr/local/bin/' + binary
        if Path(path).is_file():
            deps = command('ldd', path)
            if deps is not None:
                check('not found' not in deps, binary + ':libraries', 'No unresolved shared libraries')
                if binary == 'dwl':
                    check('libwlroots-0.19.so' in deps, 'dwl:wlroots', 'Linked against wlroots 0.19')
    for name in ('monospace', 'sans-serif', 'emoji'):
        font = command('fc-match', '-f', '%{family}', name)
        if font is not None:
            check('Noto' in font, 'font:' + name, 'Noto family selected')
    uid = 1000
    for process in ('dwl', 'dwlb', 'foot', 'pipewire', 'pipewire-pulse', 'wireplumber', 'swaybg'):
        r = subprocess.run(['pgrep', '-u', str(uid), '-x', process], capture_output=True)
        check(r.returncode == 0, 'session:' + process, 'Expected user process; run after graphical login')
    for process in ('xdg-desktop-portal', 'xdg-desktop-portal-wlr'):
        r = subprocess.run(['pgrep', '-u', str(uid), '-f', rf'^(/usr/lib/)?{process}([[:space:]]|$)'], capture_output=True)
        check(r.returncode == 0, 'session:' + process, 'Expected user portal process')
    if a.profile == 'framework':
        fstab = [l.split() for l in Path('/etc/fstab').read_text().splitlines() if l.strip() and not l.startswith('#')]
        mounts = {r[1]: r for r in fstab if len(r) >= 6 and r[2] != 'swap'}
        swaps = [r for r in fstab if len(r) >= 6 and r[2] == 'swap']
        cmdline = Path('/proc/cmdline').read_text().split()
        for target, fs, subvol in [('/', 'btrfs', '/@'), ('/.snapshots', 'btrfs', '/@snapshots'), ('/boot', 'vfat', None)]:
            row = mounts.get(target)
            valid = row is not None and row[2] == fs and row[0].startswith('UUID=')
            if valid and subvol:
                valid = {'noatime', 'compress=zstd:3', 'ssd', 'discard=async', 'space_cache=v2', 'commit=30', 'subvol=' + subvol} <= set(row[3].split(','))
            check(valid, 'fstab:' + target, 'Filesystem and reference mount options')
            mounted = command('findmnt', '-n', '-o', 'FSTYPE', '--mountpoint', target)
            if mounted is not None:
                check(mounted == fs, 'mount:' + target, 'Correct mounted filesystem type')
            if row:
                mounted_uuid = command('findmnt', '-n', '-o', 'UUID', '--mountpoint', target)
                if mounted_uuid is not None:
                    check(mounted_uuid.lower() == row[0].removeprefix('UUID=').lower(), 'uuid:' + target, 'fstab UUID matches mounted filesystem')
            if subvol:
                fsroot = command('findmnt', '-n', '-o', 'FSROOT', '--mountpoint', target)
                if fsroot is not None:
                    check(fsroot == subvol, 'subvolume:' + target, subvol)
        check(len(swaps) == 1 and swaps[0][0].startswith('UUID=') and
              {'discard=once', 'pri=100'} <= set(swaps[0][3].split(',')), 'fstab:swap', 'Dedicated swap partition with reference options')
        if mounts.get('/') and len(swaps) == 1:
            check('root=' + mounts['/'][0] in cmdline, 'boot:root', 'Running kernel uses the root UUID from fstab')
            check('resume=' + swaps[0][0] in cmdline, 'boot:resume', 'Running kernel uses the swap UUID from fstab')
            device = Path('/dev/disk/by-uuid') / swaps[0][0].removeprefix('UUID=')
            if device.exists():
                st = device.stat()
                check(Path('/sys/power/resume').read_text().strip() == f'{os.major(st.st_rdev)}:{os.minor(st.st_rdev)}',
                      'hibernate:resume-device', 'Kernel resume device matches the dedicated swap partition')
                active = command('swapon', '--noheadings', '--show=NAME')
                if active is not None:
                    check(device.resolve() in [Path(s).resolve() for s in active.splitlines()], 'swap:active', 'Resume partition is active swap')
        for token in (r'initrd=\intel-ucode.img', r'initrd=\booster-linux.img', 'rootflags=subvol=@', 'rootfstype=btrfs', 'rw', 'rootwait', 'init=/sbin/init', 'quiet', 'loglevel=4'):
            check(token in cmdline, 'cmdline:' + token.split('=')[0], 'Expected kernel argument: ' + token)
        for name in ('vmlinuz-linux', 'intel-ucode.img', 'booster-linux.img'):
            check((Path('/boot') / name).is_file(), 'boot:' + name, 'Boot artifact exists on mounted ESP')
        efi = command('efibootmgr', '-v')
        if efi is not None:
            check(any(re.match(r'Boot[0-9A-Fa-f]{4}\*? Artix\s', l) and r'\vmlinuz-linux' in l for l in efi.splitlines()),
                  'EFI:Artix', 'Direct kernel EFI entry exists')
        for name in ('home', 'hotspot', 'school'):
            path = Path('/etc/wpa_supplicant') / (name + '.conf')
            try:
                check(path.is_file() and path.stat().st_uid == 0 and not path.stat().st_mode & 0o077,
                      'wifi:' + name, 'Private root-owned profile present; credentials are never read')
            except PermissionError:
                record('UNKNOWN', 'wifi:' + name, 'Cannot inspect profile metadata')
        for name in ('Pictures/Screensaver/Screensaver', 'Pictures/Lockscreen/Lockscreen.jpg', 'VM/Windows/disk.qcow2'):
            check((Path('/home/bren') / name).is_file(), 'manual:' + name, 'Restore separately from personal backup')
        record('MANUAL', 'hardware-smoke-tests', 'Test fingerprint login, Wi-Fi profiles, Bluetooth, screen sharing, audio and hibernation physically; see docs/verify.md')
    report_path = REPO / 'local/privileged-audit.json'
    protected = None
    try:
        if os.geteuid() == 0:
            raw = command(sys.executable, str(REPO / 'scripts/audit-privileged'))
            if raw is not None:
                protected = json.loads(raw)
        elif report_path.is_file():
            protected = json.loads(report_path.read_text())
            record('REVIEW', 'protected-audit-age', 'Using the saved audit; rerun as root for current protected state')
    except (OSError, ValueError):
        record('UNKNOWN', 'protected-audit', 'Saved/protected report could not be read or parsed')
    if protected is None:
        record('UNKNOWN', 'protected-audit', 'Run scripts/audit-privileged as root to inspect protected policy and scheduled-job coverage')
    else:
        if a.profile == 'framework':
            for row in lines('wifi-methods.tsv'):
                name, option, value = row.split('\t')
                settings = {key.strip(): val.strip() for entry in protected.get('wifi_methods', {}).get(name, [])
                            for key, _, val in [entry.partition('=')]}
                check(settings.get(option) == value, 'wifi-method:' + name + ':' + option,
                      'Expected non-secret setting ' + option + '=' + value)
        defaults = {}
        for path in Path('/var/lib/pacman/local').glob('*/files'):
            data = path.read_text()
            if '%BACKUP%\n' in data:
                for row in data.split('%BACKUP%\n')[1].split('\n\n')[0].splitlines():
                    name, _, checksum = row.partition('\t')
                    defaults['/' + name] = checksum
        for name, checksum in protected.get('protected_md5', {}).items():
            check(defaults.get(name) == checksum, 'protected:' + name,
                  'Must match package default; a difference needs reviewed capture/manual provisioning')
        policy_packages = set(lines('policy-packages.txt'))
        for name in sorted(policy_packages):
            integrity = protected.get('policy_package_checks', {}).get(name)
            if integrity is None:
                record('UNKNOWN', 'package-policy:' + name, 'Rerun the collector to check packaged policy with pacman -Qkk')
            else:
                # The reference gives polkitd access to this mode-0750 directory;
                # the package archive records root:root. Check that intentional
                # difference through directories.tsv, without ignoring any other
                # Pacman warning or any file-content difference.
                check(policy_integrity_ok(name, integrity), 'package-policy:' + name,
                      'Pacman integrity; captured directory ownership is checked separately. Inspect doas pacman -Qkk ' + name + ' on failure')
        for directory in ('/etc/polkit-1/rules.d', '/etc/ssh/sshd_config.d'):
            custom = [entry['name'] for entry in protected.get(directory, [])
                      if entry.get('package') not in policy_packages]
            check(not custom, 'protected:' + directory,
                  'Uncaptured local policy: ' + ', '.join(custom) if custom else
                  'Policy is supplied by the checked packages')
        for directory in ('/var/spool/cron', '/etc/cron.d'):
            check(not protected.get(directory), 'protected:' + directory,
                  'Any custom files need explicit review; no files from this directory are deployed')
        for job in ('user_cron', 'root_cron'):
            active = [l for l in protected.get(job, {}).get('stdout', '').splitlines()
                      if l.strip() and not l.lstrip().startswith('#')]
            check(not active, 'scheduled:' + job, 'Any active entries need a separate reviewed manifest')
else:
    record('INFO', 'staging', 'Only file content and modes were checked. Packages, ownership, services and hardware require the installed host.')

counts = {level: sum(r['level'] == level for r in results)
          for level in ('PASS', 'FAIL', 'UNKNOWN', 'REVIEW', 'MANUAL', 'INFO')}
if a.json:
    print(json.dumps(dict(counts=counts, checks=results), indent=2))
else:
    for r in results:
        if r['level'] != 'PASS':
            print(f"{r['level']}: {r['check']}: {r['detail']}")
    print(' '.join(f'{k}={v}' for k, v in counts.items()))
sys.exit(1 if counts['FAIL'] else 2 if counts['UNKNOWN'] else 0)
